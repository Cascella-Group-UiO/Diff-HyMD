#!/usr/bin/bash
#!!128 cores x node, min 4 nodes!!
#SBATCH --account=???
## Wall time limit:
#SBATCH --time=0-21:00:00
## Number of nodes:
#SBATCH --nodes=8
## Number of tasks to start on each node:
#SBATCH --threads-per-core=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=32
#SBATCH --ntasks-per-socket=2
#SBATCH --sockets-per-node=2

module purge
module load GCCcore/12.3.0
module load OpenMPI/4.1.5-GCC-12.3.0
module load  Python/3.11.3-GCCcore-12.3.0
module unload CUDA/12.1.1

export OMP_NUM_THREADS=32
export OMP_PLACES=cores
export OMP_PROC_BIND=close
export OMP_WAIT_POLICY=active

#export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_PLATFORMS=cpu                 # Rimuove il warning GPU sharing
export MALLOC_ARENA_MAX=4
export SLURM_MEM_PER_CORE=1952 # This is for Betzy



srun --cpu-bind=verbose -n 32 diff_md optimize -m training/training_step25.toml -c options.toml -p topol.toml -f input.h5 -d distrib 

#srun --cpu-bind=rank_ldom -n 32 diff_md optimize -m training/training.toml -c options.toml -p topol.toml -f input.h5 -d dopc_test_out13 --restart dopc_test_out13/step_11/cpt 
#srun --cpu-bind=cores -n 32 diff_md optimize -m training/training.toml -c options.toml -p topol.toml -f input.h5 -d dopc_test_out13 --restart dopc_test_out13/step_5/cpt 

